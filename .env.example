# ─────────────────────────────────────────────────────────────
#  All in One Investor — environment variables (SERVER-SIDE ONLY)
#  Copy this file to .env.local and fill in what you have.
#  Every key is optional: missing keys switch that agent to DEMO data.
#  NEVER prefix these with NEXT_PUBLIC_ (that would leak them to browsers).
# ─────────────────────────────────────────────────────────────

# Agent D — Portfolio Manager brain (Claude). https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Agent B + C — prices, profile, financial statements, estimates, dividends
# https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Agent A — macro data (Fed funds, yields, CPI, unemployment, VIX)
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Agent A — news + sentiment.  https://www.goperigon.com
PERIGON_API_KEY=

# ── Smart notifications ──
ALERT_THRESHOLD=85
# Universe the background scanner checks (comma separated tickers)
SCAN_UNIVERSE=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AMD,AVGO,JPM,PTT.BK,AOT.BK,CPALL.BK,ADVANC.BK,KBANK.BK,7203.T,ASML,TSM,NVO,SAP

# Telegram: create a bot with @BotFather, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LINE: LINE Notify was shut down by LINE on 31 Mar 2025.
# This app uses the LINE Messaging API push endpoint instead.
# https://developers.line.biz/console/  → Messaging API channel → channel access token
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_USER_ID=

# Protects /api/scan (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=change-me-to-a-long-random-string

# ── Supabase (optional: persistent alerts + analysis history) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
